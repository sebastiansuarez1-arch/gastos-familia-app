rules_version = '2';
// ============================================================
// Pegar esto en Firebase Console > Firestore Database > Reglas
// (reemplaza el "modo de prueba" inicial). Solo los dos usuarios
// autenticados (los que creaste en Authentication) pueden leer y
// escribir. Nadie más puede acceder a los datos.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
